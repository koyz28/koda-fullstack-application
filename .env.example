# Copy to `.env` (next to docker-compose.yml) to customise the Docker setup.
# Generate a key with: docker compose run --rm backend php artisan key:generate --show
APP_KEY=
APP_PORT=8080
APP_URL=http://localhost:8080
SEED_DEMO_DATA=true

DB_DATABASE=project_tracker
DB_USERNAME=tracker
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
